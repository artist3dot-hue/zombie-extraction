# 生成文件（game/scripts/build-packs.mjs，§43）：Netlify 缓存头。文件名带内容 hash 的资源永久缓存；其余（index.html / manifest.json / 音乐等）每次校验。
/assets/app/*
  Cache-Control: public, max-age=31536000, immutable
/assets/packs/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/core/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
/assets/manifest.json
  Cache-Control: no-cache
