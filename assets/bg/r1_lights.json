{
 "version": 1,
 "pack": "v02-bg-emissive (art/production/v02-bg-emissive, rebuild: make_all.py)",
 "howToUse": [
  "Each bg_r1_<layer>_emissive image has the same size / frame grid / origin as its layer; draw it with the same frame and transform, or feed it to the lighting pass as the layer's emissive map.",
  "Mask pixel colour = the colour that pixel should show when lit (route C emissive_to_light: light = target / base, divided by 2 for the /2 light maps).  Alpha 0 = not a light.",
  "Every light is listed below per frame with its rect (frame-local px, top-left origin), kind, glow (suggested spill / halo colour), and optional flicker: buzz (short dips), broken (mostly off, rare stutters), tv (cold slow flicker), fire (L3 burning window), dead (drawn but never on).",
  "To switch one light off, crop the emissive frame to its rect (setCrop) or keep one emissive sprite per light; rects never overlap within a frame.",
  "Colours are palette colours only (rust-dusk-40 + route-A ext); none of the gameplay-reserved F/G/H/I colours - except #d09040 on L3/L4 windows that are already that colour in the base."
 ],
 "kinds": {
  "lightbox": "sign box lit from inside (face and letters)",
  "neon_letters": "channel letters only",
  "neon": "neon outline",
  "window_warm": "tungsten room light",
  "window_cold": "TV / strip light",
  "shop_window": "shop interior under tubes",
  "streetlamp": "mercury street lamp head",
  "floodlight": "flood lamp (aim given)",
  "bulb": "bare bulb",
  "bulkhead": "caged wall lamp",
  "tube": "fluorescent tube",
  "lane_signal": "toll lane signal",
  "led": "LED digits",
  "far_light": "light far down a lane",
  "fire": "burning window"
 },
