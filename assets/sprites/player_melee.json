{
 "key": "spr_player_melee",
 "image": "player_melee.png",
 "version": 2,
 "frameWidth": 96,
 "frameHeight": 80,
 "columns": 27,
 "originPx": [
  48,
  79
 ],
 "soleRow": 78,
 "coords": "frame pixel coords (top-left of the frame = 0,0), facing right; flipX the sprite and mirror x (x' = 95 - x) when facing left.  The body column matches spr_player: the melee canvas is 96x80 (the 64x56 body box centred, soles on the bottom row; 2026-09-27: 64x56 clipped the overhead frames) and the origin is the same body point (the feet), so swapping spr_player (48x56) -> spr_player_melee at the same x/y does not move the body (same parts as spr_player v02).  The sheet is a grid of `columns` frames per row (row-major frame numbers).  Hide the arm layer while a melee anim plays.  Outline is pure ink like spr_player; weapons are drawn into the frames.  Idle / run / jump with a melee weapon = spr_player + spr_player_arm_pipe / spr_player_arm_cleaver (aim-angle arm layer, same rig as the gun arms).",
 "points": {
  "grip": "near-hand fist centre on the weapon",
  "gripBack": "far-hand fist (two-handed frames only)",
  "tip": "weapon tip (pipe head / cleaver point)",
  "butt": "pipe butt end",
  "shoulder": "near shoulder",
  "lamp": "goggle lens glint (route C head-lamp anchor; same meaning as points.lamp in player.json; absent when an arm / the weapon covers the lens)",
  "weaponBox": "weapon bbox incl. outline [x0,y0,x1,y1] on that frame",
  "feet": "[x0,x1] opaque columns of the 3 rows above the sole ring - contact shadow width"
 },
 "anims_doc": "per anim: frames (sheet indices), ms (per frame), phases (windup/active/hit/recover), hitFrame/hitMs = the contact frame (apply damage + hit-stop here), activeMs = damage window (strike frame start .. contact frame end), cancelMs = earliest time the next combo swing may start.  hitbox = [x0,y0,x1,y1] frame coords: the union of the weapon over the whole active window (strike frame -> contact frame, the weapon line interpolated in between), padded 2px, at least 16px tall - use it for the whole activeMs.  hitboxSwept = the same union unpadded; hitboxContactFrame = the weapon box of the contact frame alone (reference); hitArc = the swept area as an annular sector around the contact-frame shoulder (pivotPx, rIn, rOut, fromDeg, toDeg; screen degrees, +y down, facing right) for arc-based checks.  connect = the key to switch to at hitMs when the swing lands (weapon feedback: pipe rebound / cleaver sticks); a whiff keeps playing the follow-through.  fx = slash effect to spawn at atMs: key, pivotPx (this sheet's frame coords; the fx origin goes there), anchor (arc = fx origin is the arc centre, lead = fx origin is the smear's lead point, placed on the contact frame's weapon tip, origin = fx shares the player origin), flipY (rising swings).  light = the impact light, see lighting.fxLight.",
 "lighting": {
  "format": "same set as spr_player v02: rim (manifest) + emit (manifest) + _n normal map (by name)",
  "rimSheet": "spr_player_melee_rim",
  "rimFile": "player_melee_rim.png",
  "rimRows": {
   "L": 0,
   "R": 1,
   "T": 2
  },
  "rimFrameIndex": "block * 54 + frame (3 blocks L / R / T stacked, each the same 27-column grid)",
  "rimDoc": "route C selective outline: outline pixels facing L / R / T.  v2 colour rule: the colour just inside, stepped UP its material ramp until luma >= 100 (hair / boots #181410 -> #907060, denim #1c2338 -> #607898, jacket #2f3a2c -> #5a7830; lit tops stay).  Draw the row(s) facing each light over the actor with alpha = the stepped direct-light level: near-white lights ADD with setTint(light); saturated lights (neon red, acid) setTintFill(light) so the hue is the light's (a coloured multiply goes dark).  flipX swaps L and R.  No light -> nothing (the base sheet keeps its ink outline).",
  "emitSheet": "spr_player_melee_emit",
  "emitFile": "player_melee_emit.png",
  "emitDoc": "goggle lens + glint (route C head-lamp): ADD tinted #dfe8f0 while the head-lamp is on; beam origin = points.lamp (absent on frames where an arm / the weapon covers the lens).",
  "normalMap": "player_melee_n.png",
  "normalConvention": "RGB = (n+1)/2, x right, y UP, z to viewer (OpenGL); flipX -> negate R; same rule and convention as player_n.png / player_arm_<id>_n.png (per-part bevel, 1/8 steps). Not in the manifest: load it by name if the actor light uses normals.",
  "shading": "top-front key light only, painted in 4-5 steps per material; no environment light, no rim light, no cast colour baked in, so the engine light maps (LitComposite) can multiply it.",
  "fxLight": {
   "doc": "impact lights for the route C light RTs (C NOTES 3.1).  Stamp `cookie` (shared v02-fx-icons light cookie, grey = intensity) with ADD, tint = color, alpha = alpha[tick] (one tick = tickMs from startMs = the contact frame) at atPx (player frame coords -> world).  Into the SET map clip the disc at the wall foot (rows above floorY only: a light on a wall stops where the wall meets the pavement) and stamp `ground` - the flat floor ellipse - centred under atPx on floorY with groundAlpha; into the ACTOR map stamp the disc unclipped.  when = 'connect' -> only when the swing lands (use the connect anim as the trigger), 'always' -> every swing (the smash always hits the kerb).  Respect reduceFlashing.",
   "levels": {
    "ring": [
     85,
     170,
     255
    ],
    "hot": [
     56,
     140,
     255
    ]
   },
   "seam": {
    "pattern": "bayer4x4",
    "band": 0.12,
    "topStepDithered": false,
    "doc": "a narrow ordered-dither seam straddles every step edge of the cookie (and its outer rim); the top plateau is never dithered - baked into the fx_light_* PNGs, nothing to do at runtime; if the engine generates the cookies itself use these values"
   },
   "ground": {
    "shape": "ellipse",
    "ryOverRx": 0.2,
    "levels": [
     85,
     170,
     255
    ],
    "cookies": [
     "fx_light_ground_24",
     "fx_light_ground_48"
    ],
    "doc": "flat floor pool (C v2 item 4): centred at (atPx.x, floorY), never on the wall"
   },
   "perAnim": "anims.<key>.light",
   "slashFx": "the slash fx sprites themselves are not lights (no glow on a whiff); only the contact / kerb impact lights, per anims.<key>.light"
  }
 },
