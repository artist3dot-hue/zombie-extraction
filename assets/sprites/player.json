 "soleRow": 54,
 "coords": "frame pixel coords (top-left of the frame = 0,0). The arm sheet's pivot pixel (32,32) goes on points.shoulder: arm.x = body.x + facing*(shoulder[0]-24), arm.y = body.y + (shoulder[1]-55); arm origin (0.5,0.5); flipX both when facing left. shoulderBack = judge back-hand pivot (draw spr_player_arm_judge_back BEHIND the body). armLayer=false: hide the arm layer (hurt / hurt_heavy / death / switch-middle frames have empty-handed arms baked in). points.lamp = goggle lens glint on the forehead (route C head-lamp anchor; absent when the face is hidden). ms = designed frame time (the manifest anims expand it into repeated frames).",
 "lighting": {
  "rimSheet": "spr_player_rim",
  "rimFile": "player_rim.png",
  "rimSheetAutoaim": "spr_player_autoaim_rim",
  "rimFileAutoaim": "player_autoaim_rim.png",
  "rimRows": {
   "L": 0,
   "R": 1,
   "T": 2
  },
  "rimFrameIndex": "row * 55 + frame",
  "rimDoc": "route C selective outline: outline pixels facing L / R / T, coloured with the body colour just inside; ADD under the actor light multiply, weighted by the direct light from that side; swap L/R when flipped.",
  "emitSheet": "spr_player_emit",
  "emitFile": "player_emit.png",
  "emitDoc": "goggle lens + glint (route C head-lamp); ADD tinted #dfe8f0 while the head-lamp is on; beam origin = points.lamp (absent on frames where the face is hidden / lying).",
  "normalMap": "player_n.png",
  "normalConvention": "RGB = (n+1)/2, x right, y UP, z to viewer (OpenGL); flipX -> negate R; same as player_arm_<id>_n.png. Derived from the part layout (bevel per part: pack panel broad / flat, limbs and scarf round); not in the manifest (engine loads it by name if it lights with normals). Serves spr_player_autoaim too (identical geometry).",
  "shading": "top-front key light only, 4-5 value steps per material with hue shift; no environment light, no rim light and no coloured ambient baked into the colour sheet."
 },
